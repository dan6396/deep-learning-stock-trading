# ─── Frontend (browser-exposed, must be prefixed with VITE_) ───────────────────
# Backend API base URL. Empty means same-origin /api/*, NOT bundled mock data.
# Local dev: Vite middleware serves the API. Deploys need working same-origin API routes.
VITE_API_BASE_URL=
# Legacy dashboard background re-sync interval in ms (<=0 disables polling). Default 60000.
VITE_DASHBOARD_POLL_MS=
# Legacy chart fallback only: generated mock charts on KIS failure. Default false.
VITE_ENABLE_MOCK_CHART_FALLBACK=false

# ─── KIS bridge (server-side only — NEVER expose these to the browser) ─────────
# Mock (VTS) credentials for local development.
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
# Real trading credentials. Required for real quotes + investor flow.
# KIS_REAL_APP_KEY=
# KIS_REAL_APP_SECRET=
# Environment: "mock" (default) or "real". Investor flow only populates on real.
KIS_ENV=mock

# ─── Snapshot batch / tuning (optional — sensible defaults in code) ────────────
# KIS_UNIVERSE_SIZE=20              # inline (request-time) stock count
# KIS_SNAPSHOT_UNIVERSE_SIZE=200    # batch/background-warm stock count
# KIS_AUTO_WARM=true                # warm full snapshot after inline load
# Local connection checks: set KIS_AUTO_WARM=false in .env.local to avoid full warm.
# The code default remains true; this recommendation does not change that default.
# KIS_WITH_INVESTOR_FLOW=true       # fetch investor flow during the batch
# DASHBOARD_SNAPSHOT_TTL_MS=900000  # snapshot freshness window (15 min)
# KIS_REQUEST_DELAY_MS=             # per-call delay (mock 1000 / real 200)
# KIS_STOCK_CHART_CACHE_TTL_MS=60000 # selected-stock chart cache TTL
# KIS_INTRADAY_PAGE_COUNT=14        # 1D minute-chart pages, 30 rows/page
# PIPELINE_PROJECT_ROOT=            # absolute repository root; default parent of FE cwd
# PIPELINE_OUTPUT_DIR=              # absolute output directory; default <project root>/outputs
# PIPELINE_RESULT_PATH=             # candidate JSON/CSV override; not a full-rank/marker override
# DASHBOARD_SNAPSHOT_PATH=          # override snapshot cache file path
# PYTHON_EXECUTABLE=                # absolute python.exe for the pipeline (default: <root>/venv or .venv, then py/python)

# ─── Analysis mode (server-side; restart the dev server after changing) ────────
# The analysis POST (/api/candidates/run) defaults to "full": model + news crawl + Gemini, which
# makes PAID external calls. Choose the mode explicitly before the first POST.
#   model_only  model ranking only. Never passes --run-news, removes Gemini/Naver/OpenAI keys from the
#               child process, and disables the per-stock news POST. Writes step2_* files only; the
#               news-adjusted final candidates (step3_*) are NOT produced, so /api/candidates stays []
#               and /api/backend/status reports results.candidates.state = "not_produced".
#   full        (default when unset) model + news + Gemini event extraction, needs the news keys.
# Any other value is rejected before a process starts and shows as analysisMode "unknown".
# PIPELINE_ANALYSIS_MODE=model_only

# ─── Refresh endpoint auth (set in production) ─────────────────────────────────
# When configured, send ?key= or x-refresh-key on POST /api/korean-market/refresh.
SNAPSHOT_REFRESH_KEY=
# Vercel Cron sends GET with `Authorization: Bearer $CRON_SECRET`. Set this to
# let the scheduled snapshot refresh authenticate (see vercel.json crons).
CRON_SECRET=
