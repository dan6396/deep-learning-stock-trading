# 한국투자증권 인증 (서버/파이썬 전용)
APP_KEY=
APP_SECRET=
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=
# mock 또는 real; 기본값은 mock입니다.
KIS_ENV=
# 기본 주소는 KIS_ENV에 따라 코드에서 선택됩니다.
KIS_BASE_URL=

# 뉴스 추출
GEMINI_API_KEY=
# GeminiExtractor의 코드 기본 모델은 gemini-2.5-flash-lite입니다.
GEMINI_MODEL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공급 데이터 요청 조정
# 요청 간 대기 시간(초); 기본값 0.3
KIS_SUPPLY_SLEEP_SECONDS=
# 요청 제한 시간(초); 기본값 5
KIS_SUPPLY_TIMEOUT_SECONDS=
# 최대 재시도 횟수; 기본값 2
KIS_SUPPLY_MAX_RETRIES=
# 공급 데이터 디버그 로그 사용 여부; 미설정/빈 값은 비활성화
IP_DEBUG_SUPPLY=
